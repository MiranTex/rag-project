LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_CHAT_MODEL=local-model
# Se definida, usa o OpenRouter em vez do LM Studio
OPEN_ROUTER_API_KEY=
OPEN_ROUTER_CHAT_MODEL=anthropic/claude-sonnet-5.5
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_COLLECTION=rag_documents
TOP_K=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
UPLOAD_DIR=data/uploads
# Base de dados (registo, extrações, fila de trabalhos). SQLite por defeito; para PostgreSQL:
# DATABASE_URL=postgresql+psycopg://utilizador:password@host:5432/rag
DATABASE_URL=sqlite:///backend/storage/rag.db
# Workers da fila de extração/indexação dentro da API (0 se correrem à parte com python -m backend.worker)
INDEXING_WORKERS=1
EXPORT_DIR=data/exports
AGENT_MAX_STEPS=8
# Filtro de âmbito e ficha dos documentos (modelo pequeno, só classifica e extrai campos)
GUARD_ENABLED=true
GUARD_MODEL=anthropic/claude-haiku-5.5
# OCR (Tesseract) para páginas digitalizadas sem camada de texto
OCR_ENABLED=true
OCR_LANGUAGES=por+eng
# Revisão do texto extraído antes de indexar.
# true: documentos sem alertas são indexados logo; os restantes ficam à espera de revisão.
# false: todos os documentos ficam à espera de aprovação manual.
AUTO_APPROVE_CLEAN_DOCUMENTS=false
REVIEW_MAX_GARBLED_RATIO=0.15
# Ficha do documento (tipo, título, autores, ano...) proposta pelo LLM na extração.
METADATA_EXTRACTION_ENABLED=true
# Nome dos documentos no sistema gerado da ficha (ex.: "2024 - Título"); padrão em DOCUMENT_TYPES_FILE.
AUTO_RENAME_DOCUMENTS=true
# Tipos de documento (campos da ficha e títulos de secção). Adaptar ao domínio da instituição.
DOCUMENT_TYPES_FILE=backend/document_types.json
# Uma frase sobre esta base de conhecimento, usada nos prompts.
KNOWLEDGE_BASE_DESCRIPTION=Base de conhecimento com os documentos da organização.
RERANK_WEIGHTS_DEFAULT={"vector": 0.60, "keyword": 0.25, "position": 0.10, "density": 0.05}
RERANK_WEIGHTS_GROUNDING={"vector": 0.45, "keyword": 0.30, "position": 0.20, "density": 0.05}
